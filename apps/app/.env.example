# Copy to one of:
#   .env.development  local Supabase + API (`pnpm start`; Expo loads it automatically)
#   .env.staging      staging.budgie-finances.app + staging Supabase (`pnpm start:staging`)
#   .env.production   api.budgie-finances.app + production Supabase (`pnpm start:production`)
# Variables already exported in the shell win over .env.development, so the start:* scripts override it.
# Expo exposes only variables prefixed with EXPO_PUBLIC_ to the app bundle.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-client-id
